- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):  # solo argumentos por defecto\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Averange time',   # Nombre que aparecer\xE1\
      \ en GRC\n            in_sig=[np.float32],\n            out_sig=[np.float32,\
      \ np.float32, np.float32, np.float32, np.float32]\n        )\n        # Inicializaci\xF3\
      n de acumuladores\n        self.acum_anterior = 0.0\n        self.acum_anterior1\
      \ = 0.0\n        self.acum_anterior2 = 0.0\n        self.Ntotales = 0\n\n  \
      \  def work(self, input_items, output_items):\n        x = input_items[0]  #\
      \ Se\xF1al de entrada\n        y0 = output_items[0]  # Promedio acumulado\n\
      \        y1 = output_items[1]  # Media (esperanza matem\xE1tica)\n        y2\
      \ = output_items[2]  # RMS\n        y3 = output_items[3]  # Potencia promedio\n\
      \        y4 = output_items[4]  # Desviaci\xF3n est\xE1ndar\n        # N\xFA\
      mero de muestras en este bloque\n \n\n        # --- C\xE1lculo del promedio\
      \ ---\n   \n        y0[:] = np.mean(x)\n\n        # --- C\xE1lculo de la media\
      \ cuadr\xE1tica (para RMS) ---\n\n        media_cuadratica = np.mean(x**2)\n\
      \n        # --- RMS ---\n        y2[:] = np.sqrt(media_cuadratica)\n\n     \
      \   # --- Potencia promedio ---\n        y3[:] = media_cuadratica\n\n      \
      \  # --- Media (simplemente el promedio) ---\n        y1[:] = media_cuadratica\n\
      \n        # --- Desviaci\xF3n est\xE1ndar ---\n\n        y4[:] = np.std(x)\n\
      \n        return len(x)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Averange time', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1),
      ('1', 'float', 1), ('2', 'float', 1), ('3', 'float', 1), ('4', 'float', 1)],
      '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 696.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nclass blk (gr. sync_block\
      \ ):\n    def __init__ ( self ) : # only default arguments here\n        gr.\
      \ sync_block . __init__ (self,\n        name ='Integrator', # will show up in\
      \ GRC\n        in_sig =[ np. float32 ],\n        out_sig =[ np. float32 ]\n\
      \    )\n    def work (self , input_items , output_items ):\n        x = input_items\
      \ [0] # Senial de entrada .\n        y0 = output_items [0] # Senial acumulada\n\
      \        y0 [:] = np. cumsum (x)\n        \n        return len (y0)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Integrator', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)],
      '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 352.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Differenciator',   # aparecer\xE1 en GRC\n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32]\n        )\n        self.last_sample = 0.0\
      \   # \xFAltima muestra del bloque anterior\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]   # se\xF1al de entrada\n     \
      \   y0 = output_items[0] # se\xF1al de salida (diferenciada)\n\n        # Calcular\
      \ diferencias\n        y0[0] = x[0] - self.last_sample   # primera diferencia\
      \ usando la memoria\n        y0[1:] = np.diff(x)               # diferencias\
      \ dentro del bloque\n\n        # Guardar la \xFAltima muestra del bloque actual\n\
      \        self.last_sample = x[-1]\n\n        return len(y0)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Differenciator', 'blk', [], [('0', 'float', 1)], [('0', 'float',
      1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 272.0]
    rotation: 0
    state: enabled
